<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="truck">
    <static>true</static>  <!-- Keep the arrow fixed in place -->
    
    <!-- Position the arrow in front of the robot -->
    <pose>0 0 0 0 0 0</pose>  <!-- Adjust as needed -->

    <link name="arrow_link">
      <!-- Visual Representation -->
      <visual name="arrow_visual">
        <geometry>
          <mesh>
            <uri>file:///home/mocha1410/.gazebo/models/truck/meshes/truck.stl</uri>
            <scale>0.005 0.005 0.005</scale>  <!-- Adjust size -->
          </mesh>
        </geometry>
      </visual>

      <!-- Collision -->
      <collision name="truck_collision">
        <geometry>
          <mesh>
            <uri>file:///home/mocha1410/.gazebo/models/truck/meshes/truck.stl</uri>
            <scale>0.005 0.005 0.005</scale>
          </mesh>
        </geometry>
      </collision>
    </link>
  </model>
</sdf>


